{
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"           
  ],
  "compilerOptions": {
    "target": "ES2020", 
    "module": "ESNext", 
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true, 
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    },
    "moduleResolution": "node",
  }
}
